# Server-only values. Do not prefix these with VITE_.
BALE_BOT_TOKEN=
BALE_CHAT_IDS=[]

# Optional: public HTTPS URL of the form API when the frontend is on GitHub Pages.
# Configure this as a repository Actions variable, never put bot credentials in VITE_ variables.
VITE_FORMS_API_URL=
# Usually supplied automatically by the GitHub Pages workflow.
VITE_BASE_PATH=/
# Server-only, comma-separated browser origins allowed to call the standalone API.
BALE_ALLOWED_ORIGINS=https://muhammadgolchin1.github.io
